{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "OPENSPEC_TELEMETRY": "0"
  },
  "permissions": {
    "allow": [
      "Bash(node .harness/hx.mjs *)",
      "Bash(openspec *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log)",
      "Bash(git show)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git ls-remote *)",
      "Bash(git blame *)",
      "Bash(git bisect *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -d *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git worktree list)",
      "Bash(git worktree remove *)",
      "Bash(gh pr create)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git worktree remove --force *)",
      "Bash(git worktree remove -f *)",
      "Bash(git bisect run *)",
      "Bash(gh issue create *)"
    ],
    "deny": [
      "Edit(/.harness/hx.mjs)",
      "Edit(/.harness/hooks.mjs)",
      "Edit(/.harness/versions.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.harness/hooks.mjs\" session-start", "timeout": 180 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|Skill",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.harness/hooks.mjs\" pre-tool-use" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.harness/hooks.mjs\" post-tool-use", "timeout": 120 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.harness/hooks.mjs\" stop", "timeout": 600 }
        ]
      }
    ]
  }
}
