# Géré par le template Harness (copier update). L'outillage propre à la stack est dans .harness/ci/setup/.
# Actions épinglées par SHA de commit, tenues à jour par Dependabot (.github/dependabot.yml).
name: hx-check

on:
  push:
    branches: ["{{ default_branch }}"]
  pull_request:

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}

env:
  OPENSPEC_TELEMETRY: "0"

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22
      - name: Outillage de la stack
        uses: ./.harness/ci/setup
      - name: CLI OpenSpec (version épinglée)
        run: npm i -g "@fission-ai/openspec@$(node -p "require('./.harness/versions.json').openspec")"
      - name: Dépendances
        run: node .harness/hx.mjs run setup || [ $? -eq 3 ]
      - name: hx check
        run: node .harness/hx.mjs check --verbose
